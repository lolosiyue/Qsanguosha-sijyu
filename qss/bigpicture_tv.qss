/* BP-1d big-picture dialog styling.
   Appended after the base stylesheet only when big-picture mode is active.
   Sizes are logical px; at 4K the BP-1b QT_SCALE_FACTOR=2 doubles them
   physically. Interactive controls are >= 64px tall and every focusable
   widget carries a visible focus ring so a 10-foot session can always tell
   where the highlight is. */

QDialog,
QDialog QLabel,
QDialog QGroupBox {
    font-size: 26px;
}

QDialog QGroupBox {
    font-weight: bold;
    padding-top: 24px;
}

QDialog QPushButton,
QDialog QCommandLinkButton,
QDialog QToolButton,
QDialog QComboBox {
    font-size: 26px;
    min-height: 64px;
    padding: 10px 18px;
    border: 4px solid transparent;
    border-radius: 6px;
    text-align: left;
}

QDialog QPushButton {
    text-align: center;
}

QDialog QCheckBox,
QDialog QRadioButton {
    font-size: 26px;
    padding: 6px;
    border: 4px solid transparent;
    border-radius: 6px;
}

QDialog QLineEdit,
QDialog QListWidget,
QDialog QListView,
QDialog QTextEdit,
QDialog QPlainTextEdit,
QDialog QSpinBox {
    font-size: 26px;
    border: 4px solid transparent;
    border-radius: 6px;
}

QDialog QListWidget::item,
QDialog QListView::item {
    min-height: 56px;
}

/* Visible focus ring: a high-contrast amber border on the focused widget. */
QDialog QPushButton:focus,
QDialog QCommandLinkButton:focus,
QDialog QToolButton:focus,
QDialog QComboBox:focus,
QDialog QCheckBox:focus,
QDialog QRadioButton:focus,
QDialog QLineEdit:focus,
QDialog QListWidget:focus,
QDialog QListView:focus,
QDialog QTextEdit:focus,
QDialog QPlainTextEdit:focus,
QDialog QSpinBox:focus {
    border: 4px solid #ffd84d;
}

/* The dialog's default (Enter) button also stands out when unfocused. */
QDialog QPushButton:default {
    border: 4px solid #8fb4ff;
}

QDialog QPushButton:default:focus {
    border: 4px solid #ffd84d;
}
