// Theme-pack slot registry. Each slot names one replaceable piece of room art.
// Resolution order for a slot: enabled theme packs (highest priority first), then the
// current skin's image keys ("skinKeys", first one defined wins), then "default".
// "redirect": true also routes every load of the "default" file through the theme, so
// other code that reads the same file picks up the replacement too.
// kind "directory": the slot value is a folder that mirrors "default"; each animation
// is taken whole from the first theme that has its frame 0.png.
// "colors" are text colors a theme sets so text stays readable on its backgrounds; an
// unset color keeps the room's own (the player's text color setting, or the noted default).
// "label" is English source text; theme-pack-dialog.cpp lists it for translation.
// A running room can override any slot or color for one game: Room::setUiElement.
// docs/theme-pack-guide.md explains the theme side of this file.
{
"format": 1,
"slots": [
    {"id": "card-back", "kind": "image", "group": "card", "label": "Card back",
     "default": "image/system/card-back.png", "redirect": true,
     "skinKeys": ["handCardBack", "handCardMainPhoto-unknown"], "size": [93, 130]},
    {"id": "general-card-back", "kind": "image", "group": "card", "label": "General card back",
     "default": "image/system/unknown.png", "redirect": true,
     "skinKeys": ["generalCardBack"]},
    {"id": "indicator-line", "kind": "image", "group": "effect", "label": "Indicator line",
     "default": "",
     "skinKeys": ["indicatorLine"], "size": [256, 16],
     "note": "Stretched along the line from source to target; without one the line is drawn in the source's kingdom color."},
    {"id": "emotion", "kind": "directory", "group": "effect", "label": "Emotion effects",
     "default": "image/system/emotion/", "redirect": true,
     "note": "Mirror image/system/emotion/: <name>/0.png, 1.png, ... for animations, <name>.png for single images."},
    {"id": "dashboard-equip", "kind": "image", "group": "dashboard", "label": "Dashboard equipment area",
     "default": "image/fullskin/system/dashboard-equip.png", "redirect": true,
     "skinKeys": ["dashboardLeftFrame"]},
    {"id": "dashboard-hand", "kind": "image", "group": "dashboard", "label": "Dashboard hand area",
     "default": "image/fullskin/system/dashboard-hand.png", "redirect": true,
     "skinKeys": ["dashboardMiddleFrame"]},
    {"id": "dashboard-avatar", "kind": "image", "group": "dashboard", "label": "Dashboard avatar area",
     "default": "image/fullskin/system/dashboard-avatar.png", "redirect": true,
     "skinKeys": ["dashboardRightFrame"]},
    {"id": "dashboard-button-platter", "kind": "image", "group": "dashboard", "label": "Dashboard button tray",
     "default": "image/system/button/platter/bg.png", "redirect": true,
     "skinKeys": ["dashboardButtonSetBg"]},
    {"id": "log-box-bg", "kind": "image", "group": "panel", "label": "Log background",
     "default": "",
     "skinKeys": ["logBoxBorder"],
     "note": "Nine-slice border image with a 10px edge; replaces image/system/border.png for the log box only."},
    {"id": "card-container-bg", "kind": "image", "group": "panel", "label": "CardContainer background",
     "default": "image/system/card-container.png", "redirect": true,
     "skinKeys": ["cardContainerBg"], "size": [716, 346]},
    {"id": "heroskin-container-bg", "kind": "image", "group": "panel", "label": "Skin panel background",
     "default": "image/system/heroskin-container.png", "redirect": true,
     "skinKeys": ["heroSkinContainerBg"]},
    {"id": "bubble-chat-bg", "kind": "image", "group": "panel", "label": "Chat bubble background",
     "default": "image/system/bubble.png", "redirect": true,
     "skinKeys": ["bubbleChatBg"]},
    {"id": "photo-frame", "kind": "image", "group": "seat", "label": "Seat frame",
     "default": "image/fullskin/system/photo-back.png", "redirect": true,
     "skinKeys": ["photoMainFrame"]},
    {"id": "table-bg", "kind": "image", "group": "table", "label": "Table background",
     "default": "image/system/backdrop/default.jpg", "redirect": false,
     "skinKeys": ["tableBg"]},
    {"id": "magatamas", "kind": "directory", "group": "seat", "label": "HP magatamas",
     "default": "image/fullskin/system/magatamas/",
     "note": "Mirror image/fullskin/system/magatamas/: 0.png-5.png HP icons, bg1.png-bg4.png backgrounds."},
    {"id": "phase-icons", "kind": "directory", "group": "seat", "label": "Phase icons",
     "default": "image/system/phase/",
     "note": "round_start, start, judge, draw, play, discard and finish .png."},
    {"id": "focus-frames", "kind": "directory", "group": "seat", "label": "Seat highlight frames",
     "default": "image/system/frame/",
     "note": "playing, responding, sos, photoSelected and dashboardSelected .png."},
    {"id": "handcard-count-bg", "kind": "directory", "group": "seat", "label": "Hand count badges",
     "default": "image/fullskin/system/handcard/",
     "note": "One <kingdom>.png per kingdom behind the hand card count."},
    {"id": "kingdom-frames", "kind": "directory", "group": "seat", "label": "Kingdom frames",
     "default": "image/fullskin/kingdom/frame/",
     "note": "<kingdom>.png for seats, dashboard/<kingdom>.png for the dashboard."},
    {"id": "kingdom-icons", "kind": "directory", "group": "seat", "label": "Kingdom icons",
     "default": "image/kingdom/icon/",
     "note": "One <kingdom>.png per kingdom."},
    {"id": "chain-icon", "kind": "image", "group": "seat", "label": "Chain icon",
     "default": "image/system/chain.png", "redirect": true,
     "note": "Keep the original size: the dashboard clips it to 134x19."},
    {"id": "faceturned-mask", "kind": "image", "group": "seat", "label": "Turned-over mask",
     "default": "image/fullskin/generals/faceturned.png", "redirect": true,
     "skinKeys": ["photoFaceTurnedMask", "dashboardFaceTurnedMask"]},
    {"id": "save-me-icon", "kind": "image", "group": "seat", "label": "Dying icon",
     "default": "image/system/death/save-me.png", "redirect": true,
     "skinKeys": ["saveMe"]},
    {"id": "death-icons", "kind": "directory", "group": "seat", "label": "Death icons",
     "default": "image/system/death/",
     "note": "One <role>.png per role (lord, loyalist, rebel, renegade, ...)."},
    {"id": "delayed-trick-icons", "kind": "directory", "group": "seat", "label": "Judge area icons",
     "default": "image/icon/",
     "note": "One <card name>.png per delayed trick, plus Judgelose.png."},
    {"id": "skill-buttons", "kind": "directory", "group": "button", "label": "Skill buttons",
     "default": "image/fullskin/system/button/skill/",
     "note": "Mirror image/fullskin/system/button/skill/<type>/<state>-<width>.png."},
    {"id": "dashboard-buttons", "kind": "directory", "group": "button", "label": "Confirm, cancel and discard buttons",
     "default": "image/system/button/platter/",
     "note": "Mirror image/system/button/platter/<button>/<state>.png."},
    {"id": "card-suits", "kind": "directory", "group": "card", "label": "Card suits",
     "default": "image/system/cardsuit/",
     "note": "spade, heart, club, diamond and no_suit .png."},
    {"id": "card-numbers-red", "kind": "directory", "group": "card", "label": "Red card numbers",
     "default": "image/system/red/",
     "note": "0.png-14.png."},
    {"id": "card-numbers-black", "kind": "directory", "group": "card", "label": "Black card numbers",
     "default": "image/system/black/",
     "note": "0.png-14.png."}
],
"colors": [
    {"id": "table-text", "label": "Table text color",
     "note": "Text drawn straight on the table background: chat box and replay time."},
    {"id": "log-text", "label": "Log text color",
     "note": "Log box body text and separators."},
    {"id": "log-from", "label": "Log acting player color",
     "note": "Player who acts in a log line; defaults to green."},
    {"id": "log-to", "label": "Log target player color",
     "note": "Target players in a log line; defaults to red."},
    {"id": "log-highlight", "label": "Log card and value color",
     "note": "Cards, skills and numbers in a log line; defaults to yellow."}
]
}
