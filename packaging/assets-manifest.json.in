{
  "schema_version": 1,
  "game_version": "@QSAN_GAME_VERSION@",
  "asset_pack_version": "@QSAN_ASSET_PACK_VERSION@",
  "_comment": [
    "Generated by CMake from packaging/assets-manifest.json.in - do not edit the",
    "installed copy.  The lists come from CMakeLists.txt so the manifest always",
    "describes what this build actually installs (a server-only install has no",
    "GUI assets, and must not claim to).",
    "required_paths: without these the game cannot run at all; any missing entry means the pack is broken.",
    "optional_paths: large art / audio / font content. The core runtime package deliberately omits",
    "these (several GB, also not stored in the repository); missing them only loses some sound/art, it must not crash. External assets",
    "can point at a fully stocked directory via --asset-root / QSAN_ASSET_ROOT."
  ],
  "required_paths": [
    @QSAN_ASSET_REQUIRED_JSON@
  ],
  "optional_paths": [
    @QSAN_ASSET_OPTIONAL_JSON@
  ]
}
