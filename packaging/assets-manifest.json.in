{
  "schema_version": 1,
  "game_version": "@QSAN_GAME_VERSION@",
  "asset_pack_version": "@QSAN_ASSET_PACK_VERSION@",
  "_comment": [
    "Generated by CMake from packaging/assets-manifest.json.in - do not edit the",
    "installed copy.  The lists come from CMakeLists.txt so the manifest always",
    "describes what this build actually installs (a server-only install has no",
    "GUI assets, and must not claim to).",
    "required_paths: 冇咗遊戲根本行唔到,缺任何一條都代表個包壞咗。",
    "optional_paths: 大型美術／音訊／字型內容。core runtime package 刻意唔帶",
    "呢啲(幾 GB,亦唔入 repository),缺咗只係少啲聲畫,唔可以 crash。外部資產",
    "可以用 --asset-root / QSAN_ASSET_ROOT 指向一個齊料嘅目錄。"
  ],
  "required_paths": [
    @QSAN_ASSET_REQUIRED_JSON@
  ],
  "optional_paths": [
    @QSAN_ASSET_OPTIONAL_JSON@
  ]
}
