#!/bin/sh
# Run the installed binary from the mounted image; its RUNPATH, qt.conf, and asset resolver locate bundled files.
# Do not export private Qt paths into the host environment.
set -eu

HERE="$(dirname "$(readlink -f "${0}")")"

# Used by desktop integration helpers such as appimaged.
export APPDIR="${HERE}"

exec "${HERE}/usr/bin/QSanguosha" "$@"
