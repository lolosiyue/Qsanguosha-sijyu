{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 2,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vs2026-x64",
      "displayName": "Visual Studio 2026 x64",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/builds/cmake-vs2026",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{QTDIR}"
      }
    },
    {
      "name": "xp-vs2017-x86",
      "displayName": "Windows XP SP3 x86 legacy (Qt 5.6.3 / v141_xp)",
      "generator": "Visual Studio 15 2017",
      "architecture": "Win32",
      "toolset": "v141_xp",
      "toolchainFile": "${sourceDir}/legacy/xp/cmake/toolchain-v141-xp.cmake",
      "binaryDir": "${sourceDir}/builds/cmake-xp-vs2017-x86",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{QSAN_XP_QTDIR}",
        "BUILD_TESTING": "OFF",
        "QSAN_BUILD_GUI": "ON",
        "QSAN_BUILD_SERVER": "OFF",
        "QSAN_BUILD_TUI": "OFF",
        "QSAN_BUILD_XP_LEGACY": "ON",
        "QSAN_AUDIO_BACKEND": "FMOD"
      }
    },
    {
      "name": "linux-server-gcc-debug",
      "displayName": "Linux dedicated server (GCC, Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/builds/cmake-linux-server-gcc-debug",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "BUILD_TESTING": "ON",
        "QSAN_BUILD_GUI": "OFF",
        "QSAN_BUILD_SERVER": "ON"
      }
    },
    {
      "name": "linux-gui-gcc-debug",
      "displayName": "Linux GUI client + server (GCC, Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/builds/cmake-linux-gui-gcc-debug",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "BUILD_TESTING": "ON",
        "QSAN_BUILD_GUI": "ON",
        "QSAN_BUILD_SERVER": "ON"
      }
    },
    {
      "name": "android-arm64-debug",
      "displayName": "Android arm64-v8a (Qt 6.11.1, Debug)",
      "generator": "Ninja",
      "toolchainFile": "$env{QSAN_ANDROID_QT_ROOT}/lib/cmake/Qt6/qt.toolchain.cmake",
      "binaryDir": "${sourceDir}/builds/android-arm64-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_PREFIX_PATH": "$env{QSAN_ANDROID_QT_ROOT}",
        "QT_HOST_PATH": "$env{QSAN_QT_HOST_PATH}",
        "ANDROID_SDK_ROOT": "$env{ANDROID_SDK_ROOT}",
        "ANDROID_NDK_ROOT": "$env{ANDROID_NDK_ROOT}",
        "CMAKE_ANDROID_NDK": "$env{ANDROID_NDK_ROOT}",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-28",
        "QT_ANDROID_ABIS": "arm64-v8a",
        "QT_ANDROID_COMPILE_SDK_VERSION": "36",
        "QT_ANDROID_MIN_SDK_VERSION": "28",
        "QT_ANDROID_TARGET_SDK_VERSION": "36",
        "QT_ANDROID_SDK_BUILD_TOOLS_REVISION": "36.0.0",
        "QSAN_ANDROID_FREETYPE_ROOT": "$env{QSAN_ANDROID_FREETYPE_ROOT}",
        "BUILD_TESTING": "OFF",
        "QSAN_BUILD_GUI": "ON",
        "QSAN_BUILD_SERVER": "OFF",
        "QSAN_BUILD_TUI": "OFF",
        "QSAN_BUILD_EXCEL": "OFF",
        "QSAN_BUILD_EXCEL_TESTS": "OFF",
        "QSAN_AUDIO_BACKEND": "QT"
      }
    },
    {
      "name": "android-arm64-release",
      "displayName": "Android arm64-v8a (Qt 6.11.1, Release)",
      "generator": "Ninja",
      "toolchainFile": "$env{QSAN_ANDROID_QT_ROOT}/lib/cmake/Qt6/qt.toolchain.cmake",
      "binaryDir": "${sourceDir}/builds/android-arm64-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_PREFIX_PATH": "$env{QSAN_ANDROID_QT_ROOT}",
        "QT_HOST_PATH": "$env{QSAN_QT_HOST_PATH}",
        "ANDROID_SDK_ROOT": "$env{ANDROID_SDK_ROOT}",
        "ANDROID_NDK_ROOT": "$env{ANDROID_NDK_ROOT}",
        "CMAKE_ANDROID_NDK": "$env{ANDROID_NDK_ROOT}",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-28",
        "QT_ANDROID_ABIS": "arm64-v8a",
        "QT_ANDROID_COMPILE_SDK_VERSION": "36",
        "QT_ANDROID_MIN_SDK_VERSION": "28",
        "QT_ANDROID_TARGET_SDK_VERSION": "36",
        "QT_ANDROID_SDK_BUILD_TOOLS_REVISION": "36.0.0",
        "QSAN_ANDROID_FREETYPE_ROOT": "$env{QSAN_ANDROID_FREETYPE_ROOT}",
        "BUILD_TESTING": "OFF",
        "QSAN_BUILD_GUI": "ON",
        "QSAN_BUILD_SERVER": "OFF",
        "QSAN_BUILD_TUI": "OFF",
        "QSAN_BUILD_EXCEL": "OFF",
        "QSAN_BUILD_EXCEL_TESTS": "OFF",
        "QSAN_AUDIO_BACKEND": "QT"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "vs2026-x64",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "configurePreset": "vs2026-x64",
      "configuration": "Release"
    },
    {
      "name": "xp-debug",
      "configurePreset": "xp-vs2017-x86",
      "configuration": "Debug",
      "targets": ["QSanguoshaXP", "QSanguoshaXPServer"]
    },
    {
      "name": "xp-release",
      "configurePreset": "xp-vs2017-x86",
      "configuration": "Release",
      "targets": ["QSanguoshaXP", "QSanguoshaXPServer"]
    },
    {
      "name": "xp-deploy-debug",
      "configurePreset": "xp-vs2017-x86",
      "configuration": "Debug",
      "targets": ["deploy-xp"]
    },
    {
      "name": "xp-deploy-release",
      "configurePreset": "xp-vs2017-x86",
      "configuration": "Release",
      "targets": ["deploy-xp"]
    },
    {
      "name": "relwithdebinfo-vs2026-x64",
      "configurePreset": "vs2026-x64",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "deploy-debug",
      "configurePreset": "vs2026-x64",
      "configuration": "Debug",
      "targets": ["deploy"]
    },
    {
      "name": "deploy-release",
      "configurePreset": "vs2026-x64",
      "configuration": "Release",
      "targets": ["deploy"]
    },
    {
      "name": "deploy-relwithdebinfo-vs2026-x64",
      "configurePreset": "vs2026-x64",
      "configuration": "RelWithDebInfo",
      "targets": ["deploy"]
    },
    {
      "name": "deploy-server-debug",
      "configurePreset": "vs2026-x64",
      "configuration": "Debug",
      "targets": ["deploy-server"]
    },
    {
      "name": "deploy-server-release",
      "configurePreset": "vs2026-x64",
      "configuration": "Release",
      "targets": ["deploy-server"]
    },
    {
      "name": "deploy-server-relwithdebinfo-vs2026-x64",
      "configurePreset": "vs2026-x64",
      "configuration": "RelWithDebInfo",
      "targets": ["deploy-server"]
    },
    {
      "name": "deploy-tui-debug",
      "configurePreset": "vs2026-x64",
      "configuration": "Debug",
      "targets": ["deploy-tui"]
    },
    {
      "name": "deploy-tui-release",
      "configurePreset": "vs2026-x64",
      "configuration": "Release",
      "targets": ["deploy-tui"]
    },
    {
      "name": "deploy-tui-relwithdebinfo-vs2026-x64",
      "configurePreset": "vs2026-x64",
      "configuration": "RelWithDebInfo",
      "targets": ["deploy-tui"]
    },
    {
      "name": "linux-server-debug",
      "displayName": "Linux dedicated server (GCC, Debug)",
      "configurePreset": "linux-server-gcc-debug"
    },
    {
      "name": "linux-gui-debug",
      "displayName": "Linux GUI client (GCC, Debug)",
      "configurePreset": "linux-gui-gcc-debug",
      "targets": ["QSanguosha"]
    },
    {
      "name": "android-arm64-debug",
      "configurePreset": "android-arm64-debug",
      "targets": ["QSanguosha"]
    },
    {
      "name": "android-arm64-release",
      "configurePreset": "android-arm64-release",
      "targets": ["QSanguosha"]
    },
    {
      "name": "android-arm64-debug-apk",
      "configurePreset": "android-arm64-debug",
      "targets": ["apk"]
    },
    {
      "name": "android-arm64-release-apk",
      "configurePreset": "android-arm64-release",
      "targets": ["apk"]
    }
  ]
}
