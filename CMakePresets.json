{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 4,
    "minor": 2,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vs2026-x64",
      "displayName": "Visual Studio 2026 x64",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/builds/cmake-vs2026",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{QTDIR}"
      }
    },
    {
      "name": "linux-server-gcc-debug",
      "displayName": "Linux dedicated server (GCC, Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/builds/cmake-linux-server-gcc-debug",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "BUILD_TESTING": "ON",
        "QSAN_BUILD_GUI": "OFF",
        "QSAN_BUILD_SERVER": "ON"
      }
    },
    {
      "name": "linux-gui-gcc-debug",
      "displayName": "Linux GUI client + server (GCC, Debug)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/builds/cmake-linux-gui-gcc-debug",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "BUILD_TESTING": "ON",
        "QSAN_BUILD_GUI": "ON",
        "QSAN_BUILD_SERVER": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "vs2026-x64",
      "configuration": "Debug"
    },
    {
      "name": "release",
      "configurePreset": "vs2026-x64",
      "configuration": "Release"
    },
    {
      "name": "relwithdebinfo-vs2026-x64",
      "configurePreset": "vs2026-x64",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "deploy-debug",
      "configurePreset": "vs2026-x64",
      "configuration": "Debug",
      "targets": ["deploy"]
    },
    {
      "name": "deploy-release",
      "configurePreset": "vs2026-x64",
      "configuration": "Release",
      "targets": ["deploy"]
    },
    {
      "name": "deploy-relwithdebinfo-vs2026-x64",
      "configurePreset": "vs2026-x64",
      "configuration": "RelWithDebInfo",
      "targets": ["deploy"]
    },
    {
      "name": "deploy-server-debug",
      "configurePreset": "vs2026-x64",
      "configuration": "Debug",
      "targets": ["deploy-server"]
    },
    {
      "name": "deploy-server-release",
      "configurePreset": "vs2026-x64",
      "configuration": "Release",
      "targets": ["deploy-server"]
    },
    {
      "name": "deploy-server-relwithdebinfo-vs2026-x64",
      "configurePreset": "vs2026-x64",
      "configuration": "RelWithDebInfo",
      "targets": ["deploy-server"]
    },
    {
      "name": "deploy-tui-debug",
      "configurePreset": "vs2026-x64",
      "configuration": "Debug",
      "targets": ["deploy-tui"]
    },
    {
      "name": "deploy-tui-release",
      "configurePreset": "vs2026-x64",
      "configuration": "Release",
      "targets": ["deploy-tui"]
    },
    {
      "name": "deploy-tui-relwithdebinfo-vs2026-x64",
      "configurePreset": "vs2026-x64",
      "configuration": "RelWithDebInfo",
      "targets": ["deploy-tui"]
    },
    {
      "name": "linux-server-debug",
      "displayName": "Linux dedicated server (GCC, Debug)",
      "configurePreset": "linux-server-gcc-debug"
    },
    {
      "name": "linux-gui-debug",
      "displayName": "Linux GUI client (GCC, Debug)",
      "configurePreset": "linux-gui-gcc-debug",
      "targets": ["QSanguosha"]
    }
  ]
}
