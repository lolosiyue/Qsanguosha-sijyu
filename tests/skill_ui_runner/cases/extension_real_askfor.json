{
  "schema_version": 1,
  "name": "extension_real_askfor",
  "packages": ["AIgeneral"],
  "provenance": {
    "extension": "extensions/AIgeneral.lua",
    "skill": "deep_seek",
    "room_call": "room:askForSkillInvoke(player, self:objectName(), data)"
  },
  "bootstrap": {
    "mode": "02p",
    "self": { "object_name": "self", "screen_name": "Tester", "general": "deepseek", "hp": 3, "max_hp": 3, "phase": "NotActive", "skills": ["deep_seek"] },
    "players": [{ "object_name": "target", "screen_name": "Target", "general": "liubei", "hp": 4, "max_hp": 4, "alive": true }],
    "cards": []
  },
  "request": {
    "command": "S_COMMAND_INVOKE_SKILL",
    "serial": 1009,
    "raw_body": ["deep_seek", ""]
  },
  "expect_presented": {
    "client_status": "AskForSkillInvoke",
    "prompt": { "translation_required": true, "contains": ["深度思考"], "not_contains": ["deep_seek"] },
    "skills": { "visible": ["deep_seek"] },
    "buttons": { "ok": { "enabled": true }, "cancel": { "enabled": true } }
  },
  "actions": [{ "type": "invoke_skill_yes" }],
  "expect_reply": { "command": "S_COMMAND_INVOKE_SKILL", "local_serial": 1009, "invoke": true },
  "expect_final": { "client_status": "NotActive", "open_dialog_count": 0 }
}
