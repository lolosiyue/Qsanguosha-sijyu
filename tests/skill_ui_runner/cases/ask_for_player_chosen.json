{
  "schema_version": 1,
  "name": "ask_for_player_chosen",
  "packages": ["standard"],
  "bootstrap": {
    "mode": "03_1v2",
    "self": { "object_name": "self", "screen_name": "Tester", "general": "caocao", "hp": 4, "max_hp": 4, "phase": "NotActive", "skills": [] },
    "players": [
      { "object_name": "target", "screen_name": "Target", "general": "liubei", "hp": 4, "max_hp": 4, "alive": true },
      { "object_name": "other", "screen_name": "Other", "general": "sunquan", "hp": 4, "max_hp": 4, "alive": true }
    ],
    "cards": []
  },
  "request": {
    "api": "askForPlayerChosen",
    "command": "S_COMMAND_CHOOSE_PLAYER",
    "serial": 1008,
    "args": { "players": ["target", "other"], "reason": "hujia", "prompt": "@choose-player", "max": 1, "min": 1 }
  },
  "expect_presented": { "client_status": "AskForPlayerChoose", "players": { "enabled": ["target", "other"], "unselected": ["target", "other"] }, "buttons": { "ok": { "enabled": false } } },
  "actions": [
    { "type": "select_player", "player": "target" },
    { "type": "assert", "expect": { "players": { "selected": ["target"] }, "buttons": { "ok": { "enabled": true } } } },
    { "type": "click_ok" }
  ],
  "expect_reply": { "command": "S_COMMAND_CHOOSE_PLAYER", "local_serial": 1008, "players": ["target"] },
  "expect_final": { "client_status": "NotActive", "open_dialog_count": 0 }
}
