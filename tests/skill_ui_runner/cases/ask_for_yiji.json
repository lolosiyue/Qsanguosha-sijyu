{
  "schema_version": 1,
  "name": "ask_for_yiji",
  "packages": ["standard", "standard_cards"],
  "bootstrap": {
    "mode": "03_1v2",
    "self": { "object_name": "self", "screen_name": "Tester", "general": "caocao", "hp": 4, "max_hp": 4, "phase": "NotActive", "skills": [] },
    "players": [
      { "object_name": "target", "screen_name": "Target", "general": "liubei", "hp": 4, "max_hp": 4, "alive": true },
      { "object_name": "other", "screen_name": "Other", "general": "sunquan", "hp": 4, "max_hp": 4, "alive": true }
    ],
    "cards": [
      { "alias": "slash_s7", "name": "slash", "suit": "spade", "number": 7, "owner": "self", "place": "hand" },
      { "alias": "jink_h2", "name": "jink", "suit": "heart", "number": 2, "owner": "self", "place": "hand" },
      { "alias": "peach_h3", "name": "peach", "suit": "heart", "number": 3, "owner": "self", "place": "hand" }
    ]
  },
  "request": {
    "api": "askForYiji",
    "command": "S_COMMAND_SKILL_YIJI",
    "serial": 1012,
    "args": { "cards": ["jink_h2"], "optional": true, "max_num": 1, "players": ["target"], "prompt": "" }
  },
  "expect_presented": {
    "client_status": "AskForYiji",
    "cards": { "enabled": ["jink_h2"], "disabled": ["slash_s7", "peach_h3"] },
    "players": { "unselected": ["target"] },
    "buttons": { "ok": { "enabled": false }, "cancel": { "enabled": true } }
  },
  "actions": [
    { "type": "select_card", "card": "jink_h2" },
    { "type": "select_player", "player": "target" },
    { "type": "assert", "expect": { "cards": { "selected": ["jink_h2"] }, "players": { "selected": ["target"] }, "buttons": { "ok": { "enabled": true } } } },
    { "type": "click_ok" }
  ],
  "expect_reply": { "command": "S_COMMAND_SKILL_YIJI", "local_serial": 1012, "card_aliases": ["jink_h2"], "player": "target" },
  "expect_final": { "client_status": "NotActive", "open_dialog_count": 0 }
}
