{
  "schema_version": 1,
  "name": "ask_for_exchange",
  "packages": ["standard", "standard_cards"],
  "bootstrap": {
    "mode": "02p",
    "self": { "object_name": "self", "screen_name": "Tester", "general": "caocao", "hp": 4, "max_hp": 4, "phase": "NotActive", "skills": [] },
    "players": [{ "object_name": "target", "screen_name": "Target", "general": "liubei", "hp": 4, "max_hp": 4, "alive": true }],
    "cards": [
      { "alias": "slash_s7", "name": "slash", "suit": "spade", "number": 7, "owner": "self", "place": "hand" },
      { "alias": "jink_h2", "name": "jink", "suit": "heart", "number": 2, "owner": "self", "place": "hand" }
    ]
  },
  "request": {
    "api": "askForExchange",
    "command": "S_COMMAND_EXCHANGE_CARD",
    "serial": 1007,
    "args": { "exchange_num": 2, "min_num": 1, "include_equip": false, "prompt": "@exchange", "optional": true, "pattern": "." }
  },
  "expect_presented": { "client_status": "Exchanging", "cards": { "enabled": ["slash_s7", "jink_h2"] } },
  "actions": [
    { "type": "select_card", "card": "jink_h2" },
    { "type": "assert", "expect": { "buttons": { "ok": { "enabled": true } } } },
    { "type": "click_ok" }
  ],
  "expect_reply": { "command": "S_COMMAND_DISCARD_CARD", "local_serial": 1007, "card_aliases": ["jink_h2"] },
  "expect_final": { "client_status": "NotActive", "open_dialog_count": 0 }
}
