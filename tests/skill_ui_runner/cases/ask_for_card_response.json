{
  "schema_version": 1,
  "name": "ask_for_card_response",
  "packages": ["standard", "standard_cards"],
  "bootstrap": {
    "mode": "02p",
    "self": { "object_name": "self", "screen_name": "Tester", "general": "caocao", "hp": 4, "max_hp": 4, "phase": "NotActive", "skills": [] },
    "players": [{ "object_name": "target", "screen_name": "Target", "general": "liubei", "hp": 4, "max_hp": 4, "alive": true }],
    "cards": [
      { "alias": "slash_s7", "name": "slash", "suit": "spade", "number": 7, "owner": "self", "place": "hand" },
      { "alias": "jink_h2", "name": "jink", "suit": "heart", "number": 2, "owner": "self", "place": "hand" },
      { "alias": "peach_h3", "name": "peach", "suit": "heart", "number": 3, "owner": "self", "place": "hand" }
    ]
  },
  "request": {
    "api": "askForCard",
    "command": "S_COMMAND_RESPONSE_CARD",
    "serial": 1004,
    "args": { "pattern": "jink", "prompt": "@hujia-jink:target", "method": "response", "notice_index": -1 }
  },
  "expect_presented": {
    "client_status": "Responding",
    "current_pattern": "jink",
    "use_reason": "response",
    "prompt": { "translation_required": true, "not_contains": ["@hujia-jink", "%src", "%dest", "%arg", "%arg2"] },
    "cards": { "enabled": ["jink_h2"], "disabled": ["slash_s7", "peach_h3"] }
  },
  "actions": [
    { "type": "select_card", "card": "jink_h2" },
    { "type": "assert", "expect": { "buttons": { "ok": { "enabled": true } }, "cards": { "selected": ["jink_h2"] } } },
    { "type": "click_ok" }
  ],
  "expect_reply": { "command": "S_COMMAND_RESPONSE_CARD", "local_serial": 1004, "card_alias": "jink_h2", "card_name": "jink", "targets": [] },
  "expect_final": { "client_status": "NotActive", "open_dialog_count": 0 }
}
