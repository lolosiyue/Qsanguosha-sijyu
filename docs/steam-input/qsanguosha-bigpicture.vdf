// QSanguosha "Big Picture" Steam Input template (keyboard emulation).
//
// Zero-code gamepad path: Steam Input turns pad input into the keyboard
// events the client already understands (see docs/big-picture.md and
// docs/client-core-interaction-model.md, "Native askFor keyboard support").
//
//   D-pad      -> arrow keys         (focus move / browse)
//   A          -> SPACE              (toggle / select focused item)
//   B          -> ESCAPE             (cancel / back, when the request allows)
//   Start      -> RETURN             (confirm draft / invoke "yes")
//   LB / RB    -> Shift+TAB / TAB    (previous / next focus group)
//   Y          -> CTRL+SHIFT+I       (game-state snapshot)
//   View (⧉)   -> F6                 (return focus to request dialog / table)
//
// Multi-key chords are expressed as several "binding" lines inside one
// Full_Press block (all listed keys are pressed together, e.g. LB emits
// Shift+TAB). Chords are listed modifier-first, matching Steam exports.
//
// The file follows the standard "controller_mappings" schema (version 3)
// used by Steam Deck ("controller_neptune") layout exports. To install:
// see docs/big-picture.md, section "Steam Input".
//
// Left joystick, triggers, trackpads and gyro are intentionally unbound:
// without bindings they pass through as ordinary gamepad input, which the
// client ignores until the native gamepad service (BP-1a) lands.

"controller_mappings"
{
	"version"		"3"
	"revision"		"1"
	"title"		"QSanguosha Big Picture (keyboard)"
	"description"		"Keyboard-emulation layout for QSanguosha big-picture / 10-foot mode. D-pad = arrows, A = Space, B = Esc, Start = Enter, LB/RB = Shift+Tab/Tab, Y = Ctrl+Shift+I, View = F6."
	"creator"		""
	"progenitor"		""
	"url"		""
	"export_type"		"personal_local"
	"controller_type"		"controller_neptune"
